#!/bin/sh
# Git pre-push hook: Block privacy and sensitive information leaks before pushing to remote

if [ -f "D:/ProgramData/miniforge3/python.exe" ]; then
    PYTHON_BIN="D:/ProgramData/miniforge3/python.exe"
elif python --version >/dev/null 2>&1; then
    PYTHON_BIN="python"
elif py --version >/dev/null 2>&1; then
    PYTHON_BIN="py"
elif python3 --version >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    echo "[ERROR] Valid Python interpreter not found! Cannot run privacy check." >&2
    exit 1
fi

"$PYTHON_BIN" scripts/check_privacy.py --push
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "" >&2
    echo "====================================================================" >&2
    echo "[GIT HOOK BLOCKED] 推送已被终止：发现待推送提交中包含隐私信息！" >&2
    echo "====================================================================" >&2
    exit 1
fi

exit 0
